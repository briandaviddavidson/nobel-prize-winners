# Copy to .env.local and fill in. NEXT_PUBLIC_* vars are inlined into the browser bundle,
# so restrict this key by HTTP referrer (briandaviddavidson.com/*, localhost) in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Without a Map ID the arc map uses a raster basemap with a non-interleaved overlay.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
