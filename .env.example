# Copy to .env.local and fill in. NEXT_PUBLIC_* vars are inlined into the browser bundle,
# so restrict this key by HTTP referrer (briandaviddavidson.com/*, localhost) in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. A vector Map ID (tilt and rotation enabled) turns the arc map 3D: a tilted camera
# with arcs rising off the globe. Its look comes from the map style attached to the ID in
# Cloud Console. Without one, the arc map is a flat, muted raster map.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
